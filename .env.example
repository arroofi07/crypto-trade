# Semua nilai opsional. Tidak membutuhkan wallet atau token provider.
PORT=4317
DATA_DIR=data
LOG_LEVEL=info
OPEN_BROWSER=true

# Dev hanya: origin Vite lokal yang diizinkan (tanpa trailing slash).
DEV_ORIGIN=http://127.0.0.1:5173

# Aktifkan sendiri hanya setelah menetapkan tujuan yang diizinkan. Test selalu mock.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=

# RPC Solana untuk pemeriksaan mint/konsentrasi. Kosong = https://api.mainnet-beta.solana.com
# RPC publik sering rate-limit; isi HTTPS endpoint sendiri jika pemeriksaan selalu UNKNOWN.
SOLANA_RPC_URL=

# Eksekusi on-chain: disabled (default). manual_confirm = stub fase desain V2.
EXECUTION_MODE=disabled